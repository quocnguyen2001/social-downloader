APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# API Security Configuration
API_SANITIZATION_ENABLED=true
API_STRIP_HTML=true
API_REMOVE_NULL_BYTES=true
API_TRIM_WHITESPACE=true
API_REMOVE_CONTROL_CHARS=true
API_SECURITY_HEADERS_ENABLED=true
API_MAX_REQUEST_SIZE=1048576
API_MAX_INPUT_LENGTH=10000
API_LOG_SUSPICIOUS=true
API_LOG_FAILED_VALIDATIONS=true
API_LOG_RATE_LIMITS=true
API_IP_FILTERING_ENABLED=false
API_IP_WHITELIST=
API_IP_BLACKLIST=
API_USER_AGENT_FILTERING_ENABLED=false
API_HONEYPOT_ENABLED=false
API_CSRF_ENABLED=false
API_MONITORING_ENABLED=true

# Rate Limiting Configuration
RATE_LIMIT_REGISTRATION_MAX=3
RATE_LIMIT_REGISTRATION_DECAY=60
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_DECAY=15
RATE_LIMIT_PASSWORD_RESET_MAX=3
RATE_LIMIT_PASSWORD_RESET_DECAY=60
RATE_LIMIT_LOGOUT_MAX=10
RATE_LIMIT_LOGOUT_DECAY=5
RATE_LIMIT_EXTRACTION_MAX=100
RATE_LIMIT_EXTRACTION_DECAY=60
RATE_LIMIT_TOKEN_GEN_MAX=5
RATE_LIMIT_TOKEN_GEN_DECAY=60
RATE_LIMIT_GLOBAL_MAX=1000
RATE_LIMIT_GLOBAL_DECAY=60
RATE_LIMIT_BYPASS_ENABLED=false
RATE_LIMIT_BYPASS_IPS=
RATE_LIMIT_BYPASS_USER_IDS=

# CORS Configuration
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080"
CORS_ALLOWED_ORIGINS_PATTERNS=
CORS_MAX_AGE=86400
CORS_SUPPORTS_CREDENTIALS=true

# Video Extraction Configuration
YT_DLP_USING_COOKIES=false
YT_DLP_COOKIES_FILE_PATH=app/cookie.txt
# Configure speed as "X MB in Y seconds" instead of generic MB/s
VIDEO_EXTRACTION_SPEED_DATA_AMOUNT_MB=100
VIDEO_EXTRACTION_SPEED_TIME_DURATION=30
VIDEO_EXTRACTION_SPEED_CALCULATION_METHOD=granular

# FFmpeg Configuration
FFMPEG_BINARY_PATH=ffmpeg
FFMPEG_CONVERSION_ENABLED=true
FFMPEG_CRF=18
FFMPEG_PRESET=veryfast
FFMPEG_AUDIO_BITRATE=128k
