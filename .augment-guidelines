### Custom Table Action
```php
/**
 * Create a custom activate action for users.
 *
 * @return Tables\Actions\Action
 */
private static function createActivateAction(): Tables\Actions\Action
{
    return Tables\Actions\Action::make('activate')
        ->label(trans('users.actions.activate'))
        ->icon('heroicon-o-check-circle')
        ->color('success')
        ->requiresConfirmation()
        ->modalHeading(trans('users.confirmations.activate_title'))
        ->modalDescription(trans('users.confirmations.activate_description'))
        ->modalSubmitActionLabel(trans('general.actions.confirm'))
        ->modalCancelActionLabel(trans('general.actions.cancel'))
        ->action(function (Model $record): void {
            try {
                $record->update([
                    'status' => self::STATUS_ACTIVE,
                    'activated_at' => now(),
                ]);

                // Log the action
                activity()
                    ->performedOn($record)
                    ->causedBy(auth()->user())
                    ->log('user_activated');

                Notification::make()
                    ->title(trans('users.messages.activated'))
                    ->body(trans('users.messages.activated_description', [
                        'name' => $record->name,
                    ]))
                    ->success()
                    ->send();

            } catch (Exception $e) {
                Log::error('Failed to activate user', [
                    'user_id' => $record->id,
                    'error' => $e->getMessage(),
                ]);

                Notification::make()
                    ->title(trans('users.messages.activation_failed'))
                    ->body(trans('general.messages.try_again_later'))
                    ->danger()
                    ->send();
            }
        })
        ->visible(fn(Model $record): bool => $record->status !== self::STATUS_ACTIVE)
        ->disabled(fn(Model $record): bool => !auth()->user()->can('activate', $record));
}

/**
 * Create a bulk activation action.
 *
 * @return Tables\Actions\BulkAction
 */
private static function createBulkActivateAction(): Tables\Actions\BulkAction
{
    return Tables\Actions\BulkAction::make('bulk_activate')
        ->label(trans('users.actions.bulk_activate'))
        ->icon('heroicon-o-check-circle')
        ->color('success')
        ->requiresConfirmation()
        ->modalHeading(trans('users.confirmations.bulk_activate_title'))
        ->modalDescription(function (Collection $records): string {
            return trans('users.confirmations.bulk_activate_description', [
                'count' => $records->count(),
            ]);
        })
        ->modalSubmitActionLabel(trans('general.actions.confirm'))
        ->action(function (Collection $records): void {
            $activatedCount = 0;

            DB::transaction(function () use ($records, &$activatedCount): void {
                foreach ($records as $record) {
                    if ($record->status !== self::STATUS_ACTIVE) {
                        $record->update([
                            'status' => self::STATUS_ACTIVE,
                            'activated_at' => now(),
                        ]);
                        $activatedCount++;
                    }
                }
            });

            Notification::make()
                ->title(trans('users.messages.bulk_activated', [
                    'count' => $activatedCount,
                ]))
                ->success()
                ->send();
        })
        ->deselectRecordsAfterCompletion();
}
```

