#### Organized fields with sections (PSR-12 Compliant)
```php
/**
 * Configure the form schema for user creation and editing.
 *
 * @param Form $form The form instance
 * @return Form The configured form
 */
public static function form(Form $form): Form
{
    return $form
        ->schema([
            Forms\Components\Section::make(trans('users.sections.basic_info'))
                ->description(trans('users.sections.basic_info_description'))
                ->schema([
                    Forms\Components\TextInput::make('name')
                        ->label(trans('users.fields.name'))
                        ->required()
                        ->maxLength(255)
                        ->rules(['string', 'max:255'])
                        ->placeholder(trans('users.placeholders.name')),

                    Forms\Components\TextInput::make('email')
                        ->label(trans('users.fields.email'))
                        ->email()
                        ->required()
                        ->unique(ignoreRecord: true)
                        ->maxLength(255)
                        ->placeholder(trans('users.placeholders.email')),
                ])
                ->columns(2)
                ->collapsible(),

            Forms\Components\Section::make(trans('users.sections.account_settings'))
                ->description(trans('users.sections.account_settings_description'))
                ->schema([
                    Forms\Components\Select::make('role_id')
                        ->label(trans('users.fields.role'))
                        ->relationship('role', 'name')
                        ->searchable()
                        ->preload()
                        ->required()
                        ->placeholder(trans('users.placeholders.role')),

                    Forms\Components\Select::make('status')
                        ->label(trans('users.fields.status'))
                        ->options(self::getStatusOptions())
                        ->default(self::STATUS_PENDING)
                        ->required()
                        ->placeholder(trans('users.placeholders.status')),

                    Forms\Components\Toggle::make('is_active')
                        ->label(trans('users.fields.is_active'))
                        ->helperText(trans('users.help.is_active'))
                        ->default(true),

                    Forms\Components\Toggle::make('email_verified')
                        ->label(trans('users.fields.email_verified'))
                        ->helperText(trans('users.help.email_verified'))
                        ->default(false),
                ])
                ->columns(2)
                ->collapsible(),

            Forms\Components\Section::make(trans('users.sections.profile'))
                ->description(trans('users.sections.profile_description'))
                ->schema([
                    Forms\Components\FileUpload::make('avatar')
                        ->label(trans('users.fields.avatar'))
                        ->image()
                        ->directory('avatars')
                        ->visibility('public')
                        ->maxSize(1024)
                        ->acceptedFileTypes(['image/jpeg', 'image/png'])
                        ->helperText(trans('users.help.avatar')),

                    Forms\Components\Textarea::make('bio')
                        ->label(trans('users.fields.bio'))
                        ->maxLength(500)
                        ->rows(3)
                        ->placeholder(trans('users.placeholders.bio')),
                ])
                ->columns(1)
                ->collapsible(),
        ]);
}

/**
 * Get form validation rules for user data.
 *
 * @return array<string, array<string>>
 */
public static function getFormValidationRules(): array
{
    return [
        'name' => ['required', 'string', 'max:255'],
        'email' => ['required', 'email', 'max:255', 'unique:users,email'],
        'role_id' => ['required', 'exists:roles,id'],
        'status' => ['required', 'in:' . implode(',', array_keys(self::getStatusOptions()))],
        'is_active' => ['boolean'],
        'email_verified' => ['boolean'],
        'avatar' => ['nullable', 'image', 'max:1024'],
        'bio' => ['nullable', 'string', 'max:500'],
    ];
}
```

#### Validation with Translated Messages (PSR-12 Compliant)
```php
/**
 * Configure form field with validation and translation.
 */
private static function configurePhoneField(): Forms\Components\TextInput
{
    return Forms\Components\TextInput::make('phone')
        ->label(trans('users.fields.phone'))
        ->tel()
        ->rules([
            'nullable',
            'string',
            'regex:/^([0-9\s\-\+\(\)]*)$/',
            'min:10',
            'max:20',
        ])
        ->validationMessages([
            'regex' => trans('users.validation.phone_invalid'),
            'min' => trans('users.validation.phone_min'),
            'max' => trans('users.validation.phone_max'),
        ])
        ->placeholder(trans('users.placeholders.phone'))
        ->helperText(trans('users.help.phone'))
        ->prefixIcon('heroicon-m-phone');
}

/**
 * Configure password field with confirmation.
 */
private static function configurePasswordFields(): array
{
    return [
        Forms\Components\TextInput::make('password')
            ->label(trans('users.fields.password'))
            ->password()
            ->required(fn(string $context): bool => $context === 'create')
            ->dehydrated(fn(?string $state): bool => filled($state))
            ->dehydrateStateUsing(fn(string $state): string => Hash::make($state))
            ->rules([
                'nullable',
                'string',
                'min:8',
                'regex:/^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)/',
            ])
            ->validationMessages([
                'min' => trans('users.validation.password_min'),
                'regex' => trans('users.validation.password_format'),
            ])
            ->helperText(trans('users.help.password')),

        Forms\Components\TextInput::make('password_confirmation')
            ->label(trans('users.fields.password_confirmation'))
            ->password()
            ->required(fn(string $context): bool => $context === 'create')
            ->dehydrated(false)
            ->rules(['same:password'])
            ->validationMessages([
                'same' => trans('users.validation.password_confirmation'),
            ]),
    ];
}
```

