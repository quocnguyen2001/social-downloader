/**
 * Modify the Eloquent query for the resource.
 *
 * @return Builder The modified query builder
 */
public static function getEloquentQuery(): Builder
{
    return parent::getEloquentQuery()
        ->with([
            'role:id,name',
            'permissions:id,name',
            'profile:user_id,avatar,bio',
        ])
        ->withCount(['posts', 'comments'])
        ->select([
            'id',
            'name',
            'email',
            'status',
            'is_active',
            'email_verified_at',
            'created_at',
            'updated_at',
        ]);
}

/**
 * Apply global scopes to the query.
 *
 * @param Builder $query
 * @return Builder
 */
public static function modifyQuery(Builder $query): Builder
{
    return $query
        ->when(
            auth()->user()->hasRole('manager'),
            fn(Builder $q): Builder => $q->where('company_id', auth()->user()->company_id)
        )
        ->when(
            request()->has('active_only'),
            fn(Builder $q): Builder => $q->where('is_active', true)
        );
}
